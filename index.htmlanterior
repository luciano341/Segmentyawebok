<script>
function goTo(id){var el=document.getElementById(id);if(el)el.scrollIntoView({behavior:'smooth',block:'start'});}
function openModal(){document.getElementById('modal-overlay').classList.add('open');document.getElementById('modal-form-wrap').style.display='block';document.getElementById('modal-success').style.display='none';document.body.style.overflow='hidden';}
function closeModal(){document.getElementById('modal-overlay').classList.remove('open');document.body.style.overflow='';}
function closeModalOutside(e){if(e.target===document.getElementById('modal-overlay'))closeModal();}
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeModal();});
function toggleMenu(){document.getElementById('mobile-menu').classList.toggle('open');document.getElementById('hamburger').classList.toggle('open');}
window.addEventListener('scroll',function(){document.getElementById('mobile-menu').classList.remove('open');document.getElementById('hamburger').classList.remove('open');});
var obs=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');obs.unobserve(e.target);}});},{threshold:0.1});
document.querySelectorAll('.reveal').forEach(function(el){obs.observe(el);});

function selectPhase(n){
  for(var i=1;i<=5;i++){
    var ph=document.getElementById('phase-'+i);
    var nd=document.getElementById('node-'+i);
    if(i===n){
      ph&&ph.classList.add('active');
      nd&&nd.classList.add('active');
    } else {
      ph&&ph.classList.remove('active');
      nd&&nd.classList.remove('active');
    }
  }
}

function fN(n){if(n>=1000000)return(n/1000000).toFixed(1).replace('.',',')+'M';if(n>=10000)return Math.round(n/1000)+'K';if(n>=1000)return(n/1000).toFixed(1).replace('.',',')+'K';return Math.round(n).toLocaleString('es-AR');}
function fM(n){if(n>=1000000000)return'$'+(n/1000000000).toFixed(1).replace('.',',')+'B';if(n>=1000000)return'$'+(n/1000000).toFixed(1).replace('.',',')+'M';if(n>=10000)return'$'+Math.round(n/1000)+'K';return'$'+Math.round(n).toLocaleString('es-AR');}
function calcUpdate(){
  var vis=+document.getElementById('r-visitas').value,tiend=+document.getElementById('r-tiendas').value,regA=0.15,ticket=+document.getElementById('r-ticket').value,recomp=3,regO=0.55;
  document.getElementById('v-visitas').textContent=vis.toLocaleString('es-AR');document.getElementById('v-tiendas').textContent=tiend;document.getElementById('v-ticket').textContent=ticket>=1000?'$'+Math.round(ticket/1000)+'K':'$'+ticket.toLocaleString('es-AR');
  var captMax=vis*tiend*regO,gapDia=Math.max(captMax-vis*tiend*regA,0),gapMes=gapDia*30,gapAno=gapMes*12,ltv=ticket*recomp,rev=gapAno*ltv,gapPp=Math.round((regO-regA)*100);
  document.getElementById('r-mes').textContent=fN(gapMes);document.getElementById('r-ano').textContent=fN(gapAno);document.getElementById('r-gap').textContent=gapPp>0?'+'+gapPp+'pp':'0pp';document.getElementById('r-rev').textContent=fM(rev);document.getElementById('r-ltv').textContent=fM(ltv);
  document.getElementById('gauge-arc').style.strokeDashoffset=245-(245*Math.min(gapDia/Math.max(captMax,1),1));
  document.getElementById('ins-1').textContent='Captúrás el '+Math.round(regA*100)+'% de los contactos. El benchmark con CRM activo es 55%, un salto de '+gapPp+' pp.';
  document.getElementById('ins-2').textContent='Son '+fN(gapMes)+' contactos no captados por mes entre tus '+tiend+' tienda'+(tiend>1?'s':'')+', o '+fN(gapAno)+' al año.';
  document.getElementById('ins-3').textContent='Ticket '+fM(ticket)+' × '+recomp+'× recompra = LTV '+fM(ltv)+' por contacto. Total no capturado: '+fM(rev)+' anuales.';
}
calcUpdate();

function fDC(n){
  if(n>=1000000000)return'$'+(n/1000000000).toFixed(1).replace('.',',')+'B';
  if(n>=1000000)return'$'+(n/1000000).toFixed(1).replace('.',',')+'M';
  if(n>=10000)return'$'+Math.round(n/1000)+'K';
  return'$'+Math.round(n).toLocaleString('es-AR');
}
function dcUpdate(){
  var clientes = +document.getElementById('dc-clientes').value;
  var ticket   = +document.getElementById('dc-ticket').value;
  var pEmail   = +document.getElementById('dc-email').value/100;
  var pWsp     = +document.getElementById('dc-whatsapp').value/100;
  var pCumple  = +document.getElementById('dc-cumple').value/100;

  // Display values
  document.getElementById('dv-clientes').textContent = clientes.toLocaleString('es-AR');
  document.getElementById('dv-ticket').textContent   = ticket>=1000?'$'+Math.round(ticket/1000)+'K':'$'+ticket.toLocaleString('es-AR');
  document.getElementById('dv-email').textContent    = Math.round(pEmail*100)+'%';
  document.getElementById('dv-whatsapp').textContent = Math.round(pWsp*100)+'%';
  document.getElementById('dv-cumple').textContent   = Math.round(pCumple*100)+'%';

  // Score de completitud (promedio ponderado)
  var score = Math.round((pEmail*0.4 + pWsp*0.4 + pCumple*0.2) * 100);
  document.getElementById('dc-score').textContent = score+'%';
  document.getElementById('dc-score-bar').style.width = score+'%';
  var scoreLabel = score < 30 ? 'Base con mucho potencial de mejora' :
                   score < 55 ? 'Base con oportunidad de mejora' :
                   score < 75 ? 'Base bien desarrollada' : 'Base de alto rendimiento';
  document.getElementById('dc-score-label').textContent = scoreLabel;

  // Revenue por canal
  // Email: clientes con email × ticket × frecuencia recompra (1.5x) × tasa conversión email (2%)
  var revEmail  = clientes * pEmail  * ticket * 1.5 * 0.02 * 1.60; // +60% apertura benchmark
  // WhatsApp: clientes con wsp × ticket × frecuencia (2x, más frecuente) × tasa conversión wsp (4%, mayor apertura)
  var revWsp    = clientes * pWsp    * ticket * 2   * 0.04 * 1.20; // +20% clics benchmark
  // Cumpleaños: clientes con fecha × ticket × 3x conversión × tasa base 3%
  var revCumple = clientes * pCumple * ticket * 1   * 0.05 * 1.05; // +5% conversión benchmark
  var revTotal  = revEmail + revWsp + revCumple;

  document.getElementById('dc-rev-email').textContent  = fDC(revEmail);
  document.getElementById('dc-rev-wsp').textContent    = fDC(revWsp);
  document.getElementById('dc-rev-cumple').textContent = fDC(revCumple);
  document.getElementById('dc-rev-total').textContent  = fDC(revTotal);

  // Barras proporcionales
  var maxRev = Math.max(revEmail, revWsp, revCumple, 1);
  document.getElementById('dc-bar-email').style.width  = Math.round(revEmail/maxRev*100)+'%';
  document.getElementById('dc-bar-wsp').style.width    = Math.round(revWsp/maxRev*100)+'%';
  document.getElementById('dc-bar-cumple').style.width = Math.round(revCumple/maxRev*100)+'%';

  // Oportunidad perdida — brecha hasta 90% en cada canal
  var targetEmail  = 0.90; var targetWsp = 0.70; var targetCumple = 0.60;
  var gapEmail  = Math.max(targetEmail  - pEmail,  0);
  var gapWsp    = Math.max(targetWsp    - pWsp,    0);
  var gapCumple = Math.max(targetCumple - pCumple, 0);

  var potEmail  = clientes * gapEmail  * ticket * 1.5 * 0.02 * 1.60;
  var potWsp    = clientes * gapWsp    * ticket * 2   * 0.04 * 1.20;
  var potCumple = clientes * gapCumple * ticket * 1   * 0.05 * 1.05;
  var potTotal  = potEmail + potWsp + potCumple;

  document.getElementById('dc-insight-1').textContent =
    'Tu base tiene un score de '+score+'%. Si llegaras al nivel óptimo (email 90%, WhatsApp 70%, cumpleaños 60%), podrías generar '+fDC(potTotal)+' adicionales por año.';
  document.getElementById('dc-insight-2').textContent =
    gapWsp > 0.1 ?
    'El mayor potencial está en WhatsApp: capturar el número de ' + Math.round(gapWsp*clientes).toLocaleString('es-AR') + ' clientes más te habilitaría el canal de mayor tasa de apertura del mercado (98%).' :
    'Tu cobertura de WhatsApp es muy buena. El foco ahora debería estar en activar y segmentar bien esos contactos.';
  document.getElementById('dc-insight-3').textContent =
    pCumple < 0.40 ?
    'Las campañas de cumpleaños tienen 3× más conversión. Con '+Math.round(gapCumple*clientes).toLocaleString('es-AR')+' fechas más por capturar, estás dejando '+fDC(potCumple)+' sobre la mesa.' :
    'Buena cobertura de fechas de nacimiento. Potenciá esa data con ofertas personalizadas anticipadas.';
}
dcUpdate();

async function sendForm(e){
  e.preventDefault();
  var btn=document.getElementById('fbtn');btn.textContent='Enviando...';btn.disabled=true;
  var email=document.getElementById('fe').value;
  try{
    var r=await fetch('https://formspree.io/f/mreobdob',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({nombre:document.getElementById('fn').value,email:email,empresa:document.getElementById('fc').value,mensaje:document.getElementById('fm').value})});
    if(r.ok){
      document.getElementById('fok').textContent=email;document.getElementById('modal-form-wrap').style.display='none';document.getElementById('modal-success').style.display='block';
    } else {
      btn.textContent='Error al enviar. Intentá de nuevo.';btn.disabled=false;
    }
  } catch(err){
    btn.textContent='Error de conexión. Intentá de nuevo.';btn.disabled=false;
  }
}
</script>
</body>
</html>
